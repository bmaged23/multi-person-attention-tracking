# Copy to .env. Shell environment overrides this file; CLI flags override both.
# Paths are relative to the repository root. Credentials are not required.
ATTENTION_DEVICE=cpu
ATTENTION_DETECTION_MODE=people
ATTENTION_MODEL_PATH=models/face_landmarker.task
ATTENTION_PERSON_MODEL_PATH=models/yolov8n.onnx
ATTENTION_TILE_WORKERS=8
ATTENTION_PERSON_TILES=2
ATTENTION_PERSON_CONFIDENCE=0.15
ATTENTION_DETECTION_CONFIDENCE=0.35
ATTENTION_PRESENCE_CONFIDENCE=0.25
ATTENTION_IOU_THRESHOLD=0.5
ATTENTION_TRACK_TIMEOUT=1.0
ATTENTION_SHOW_LANDMARKS=false

# Established scoring defaults; changing these changes the attention rule.
ATTENTION_YAW_LIMIT=39.4
ATTENTION_PITCH_DOWN=-24.6
ATTENTION_PITCH_UP=41.6
ATTENTION_EAR_CLOSED=0.092
ATTENTION_IRIS_SIDE=0.37
ATTENTION_HEAD_WEIGHT=0.50
ATTENTION_EYE_WEIGHT=0.15
ATTENTION_GAZE_WEIGHT=0.10
ATTENTION_VISIBILITY_WEIGHT=0.25
ATTENTION_ATTENTIVE_MIN=0.50
ATTENTION_PARTIAL_MIN=0.25

# Person runtime is independent of the MediaPipe landmark delegate above.
# CUDA: set BACKEND=onnx and DEVICE=cuda. CPU defaults preserve the original route.
ATTENTION_PERSON_BACKEND=opencv
ATTENTION_PERSON_DEVICE=cpu

# Local upload API bounds; API jobs are sequential.
ATTENTION_API_DATA_DIR=data/api
ATTENTION_API_MAX_UPLOAD_MB=64
ATTENTION_API_UPLOAD_TIMEOUT_SECONDS=60
ATTENTION_API_MAX_CLIP_SECONDS=10
ATTENTION_API_MAX_FRAME_PIXELS=2073600
ATTENTION_API_MAX_SOURCE_FPS=60
ATTENTION_API_RETAINED_JOBS=10
